
#
# RT-Thread
#

#
# Kernel basics
#
CONFIG_RT_THREAD_PRIORITY_MAX=32
CONFIG_RT_TICK_PER_SECOND=1000
CONFIG_RT_ALIGN_SIZE=4
CONFIG_RT_NAME_MAX=32
# end of Kernel basics

#
# Startup
#
CONFIG_RT_USING_COMPONENTS_INIT=y
CONFIG_RT_USING_USER_MAIN=y
CONFIG_RT_MAIN_THREAD_STACK_SIZE=1024
# end of Startup

#
# Diagnostics and hooks
#
# CONFIG_RT_DEBUG is not set
CONFIG_RT_DEBUG_INIT=0
# CONFIG_RT_USING_OVERFLOW_CHECK is not set
# CONFIG_RT_USING_HOOK is not set
# end of Diagnostics and hooks

#
# Software timers
#
# CONFIG_RT_USING_TIMER_SOFT is not set
# end of Software timers

#
# Inter-process communication
#
CONFIG_RT_USING_SEMAPHORE=y
# CONFIG_RT_USING_MUTEX is not set
# CONFIG_RT_USING_EVENT is not set
CONFIG_RT_USING_MAILBOX=y
# CONFIG_RT_USING_MESSAGEQUEUE is not set
# end of Inter-process communication

#
# Dynamic memory
#
CONFIG_RT_USING_HEAP=y
CONFIG_RT_USING_SMALL_MEM=y
CONFIG_RT_USING_SMALL_MEM_AS_HEAP=y
# CONFIG_RT_USING_MEMPOOL is not set
# CONFIG_RT_USING_TINY_SIZE is not set
# end of Dynamic memory

#
# Components
#

#
# Console
#
CONFIG_RT_USING_CONSOLE=y
CONFIG_RT_CONSOLEBUF_SIZE=1024
CONFIG_RT_CONSOLE_DEVICE_NAME="uart2"
# end of Console

CONFIG_RT_USING_DEVICE=y

#
# FinSH shell
#
CONFIG_RT_USING_FINSH=y
CONFIG_FINSH_USING_SYMTAB=y
CONFIG_FINSH_USING_DESCRIPTION=y
CONFIG_MSH_USING_BUILT_IN_COMMANDS=y
# end of FinSH shell
# end of Components
# end of RT-Thread
