{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build STM32F4",
      "type": "process",
      "command": "C:/msys64/ucrt64/bin/cmake.exe",
      "args": [
        "--build",
        "--preset",
        "stm32f4",
        "--target",
        "rtthread",
        "--parallel"
      ],
      "problemMatcher": "$gcc",
      "group": "build"
    },
    {
      "label": "Download STM32F4",
      "type": "process",
      "command": "C:/msys64/usr/bin/bash.exe",
      "args": [
        "-lc",
        ". .venv/bin/activate && python Scripts/download.py --jlink /d/App/Code/JLink/JLink_V968a/JLink.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "MSYSTEM": "UCRT64",
          "CHERE_INVOKING": "1"
        }
      },
      "problemMatcher": []
    }
  ]
}
