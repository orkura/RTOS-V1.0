{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure STM32F4 Debug",
      "type": "process",
      "command": "C:/msys64/ucrt64/bin/cmake.exe",
      "args": [
        "--preset",
        "stm32f4-debug"
      ],
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build STM32F4 Debug",
      "type": "process",
      "command": "C:/msys64/ucrt64/bin/cmake.exe",
      "args": [
        "--build",
        "--preset",
        "stm32f4-debug",
        "--target",
        "rtthread",
        "--parallel"
      ],
      "problemMatcher": "$gcc",
      "dependsOn": "Configure STM32F4 Debug",
      "dependsOrder": "sequence",
      "group": "build"
    },
    {
      "label": "Configure STM32F4 Release",
      "type": "process",
      "command": "C:/msys64/ucrt64/bin/cmake.exe",
      "args": [
        "--preset",
        "stm32f4-release"
      ],
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build STM32F4 Release",
      "type": "process",
      "command": "C:/msys64/ucrt64/bin/cmake.exe",
      "args": [
        "--build",
        "--preset",
        "stm32f4-release",
        "--target",
        "rtthread",
        "--parallel"
      ],
      "problemMatcher": "$gcc",
      "dependsOn": "Configure STM32F4 Release",
      "dependsOrder": "sequence",
      "group": "build"
    },
    {
      "label": "Download STM32F4 Debug",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python.exe",
      "args": [
        "Scripts/download.py",
        "--jlink",
        "D:/App/Code/JLink/JLink_V968a/JLink.exe",
        "--firmware",
        "build/stm32f4-debug/rtthread-stm32f4.hex",
        "--device",
        "STM32F407ZG",
        "--interface",
        "SWD",
        "--speed",
        "4000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Build STM32F4 Debug",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Download STM32F4 Release",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python.exe",
      "args": [
        "Scripts/download.py",
        "--jlink",
        "D:/App/Code/JLink/JLink_V968a/JLink.exe",
        "--firmware",
        "build/stm32f4-release/rtthread-stm32f4.hex",
        "--device",
        "STM32F407ZG",
        "--interface",
        "SWD",
        "--speed",
        "4000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Build STM32F4 Release",
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
