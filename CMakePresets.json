{
    "version": 2,

    "configurePresets": [
        {
            "name": "base",
            "hidden": true,

            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",

            "environment": {
                "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
            },

            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Generic",
                "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",

                "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe",
                "CMAKE_ASM_COMPILER": "C:/msys64/ucrt64/bin/arm-none-eabi-gcc.exe",
                "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/arm-none-eabi-gcc.exe"
                
            }
        },
        {
            "name": "cc2538-debug",
            "displayName": "CC2538 Debug",
            "description": "Build the CC2538 BSP in Debug mode.",

            "inherits": "base",
            "cacheVariables": {
                "TARGET_BSP": "cc2538",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "cc2538-release",
            "displayName": "CC2538 Release",
            "description": "Build the CC2538 BSP in Release mode.",

            "inherits": "base",
            "cacheVariables": {
                "TARGET_BSP": "cc2538",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "stm32f4-debug",
            "displayName": "STM32F4 Debug",
            "description": "Build the STM32F4 BSP in Debug mode.",

            "inherits": "base",
            "cacheVariables": {
                "TARGET_BSP": "stm32f4",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "stm32f4-release",
            "displayName": "STM32F4 Release",
            "description": "Build the STM32F4 BSP in Release mode.",

            "inherits": "base",
            "cacheVariables": {
                "TARGET_BSP": "stm32f4",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "stm32h743vit-debug",
            "displayName": "STM32H743VIT Debug",
            "description": "Build the STM32H743VIT6 BSP in Debug mode.",

            "inherits": "base",
            "cacheVariables": {
                "TARGET_BSP": "stm32h743vit",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "stm32h743vit-release",
            "displayName": "STM32H743VIT Release",
            "description": "Build the STM32H743VIT6 BSP in Release mode.",

            "inherits": "base",
            "cacheVariables": {
                "TARGET_BSP": "stm32h743vit",
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],

    "buildPresets": [
        {
            "name": "cc2538-debug",
            "configurePreset": "cc2538-debug"
        },
        {
            "name": "cc2538-release",
            "configurePreset": "cc2538-release"
        },
        {
            "name": "stm32f4-debug",
            "configurePreset": "stm32f4-debug"
        },
        {
            "name": "stm32f4-release",
            "configurePreset": "stm32f4-release"
        },
        {
            "name": "stm32h743vit-debug",
            "configurePreset": "stm32h743vit-debug"
        },
        {
            "name": "stm32h743vit-release",
            "configurePreset": "stm32h743vit-release"
        }
    ]
}
